# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# internal docs - NEVER deploy or commit (IP-sensitive)
/internal/

# Impeccable local run artifacts (config + design record are tracked)
.impeccable/live/
.impeccable/critique/
.impeccable/review/
# transient screenshot scratch from critique/review agents
.impeccable/shots*/

# graphify knowledge-graph build output
graphify-out/

.env*
!.env.example

# video masters
# Source recordings, kept locally and deliberately not tracked. The site serves
# the optimised copies in public/media/ and references nothing in these folders,
# so tracking them would put ~149MB of unreferenced binaries in history forever
# and publish the originals at easychip.org.
/public/home_page_demo/
/public/chronological_features_demo/

# -- Supabase - stores inbound leads from the contact form. Nothing else.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# -- Calendly - the demo booking embed on /contact (#book)
#
# Use the URL of a specific event type, not the bare account URL: the account
# URL lands a visitor on a menu of event types, which is a dead step at the end
# of the funnel.
#
#   good  https://calendly.com/easychip/30min
#   bad   https://calendly.com/easychip
#
# NEXT_PUBLIC_ is inlined at build time, so changing this on the host does
# nothing until the next deploy. Leave it unset and /contact says so plainly
# rather than embedding a broken calendar.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-team/30min
